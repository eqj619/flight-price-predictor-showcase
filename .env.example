# このファイルをコピーして .env を作る:  cp .env.example .env
# .env は .gitignore 済み。秘密情報はコードに直書きしない。

# --- ストレージ ---
DB_PATH=./data/flights.db

# --- タイムゾーン ---
# 収集ジョブの実行日と、ユーザーに見せる「今日」の基準。
# date.today() は OS のタイムゾーンに従ってしまうので、アプリ内の「今日」は
# 必ずこの設定を見る（app/clock.py）。
TIMEZONE=America/Los_Angeles

# --- ログ ---
LOG_LEVEL=INFO
# 常駐プロセスなのでログは必ず回す。
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=3

# --- スケジューラ ---
# Web プロセスから日次ジョブを回すかどうか。
# cron / launchd / EventBridge から `python -m app.cli run-daily` を叩く
# 運用にするなら false にする。
SCHEDULER_ENABLED=true
# 実行時刻（TIMEZONE 基準）。収集は500ルートで90分近くかかりうるので、
# 利用が少ない時間帯に置く。
DAILY_RUN_HOUR=3
DAILY_RUN_MINUTE=0
# 停止していた間に実行時刻を過ぎていた場合、この猶予内なら追いつく。
JOB_MISFIRE_GRACE_SECONDS=3600

# --- 収集のポライトネス（既存 flight-price-monitor/config.py を踏襲）---
REQUEST_DELAY_MIN_SECONDS=2.0
REQUEST_DELAY_MAX_SECONDS=5.0
MAX_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=3.0

# --- 収集の範囲 ---
MAX_STOPS=1
TOP_N_AIRLINES=5
# LCC を airlines フィルタで明示検索する深さ。0 = 直行便のみ。
# 1ルートあたりのリクエスト数に直結する（0 なら3回、1 なら4回）。
LCC_SEARCH_MAX_STOPS=0

# --- 上限（匿名なので人単位で縛れない。Phase 0 Q4 の決定値）---
# 日次クエリ数は「監視中の異なる (出発, 到着, 出発日) の数」に比例する。
# 500 ルート x 2 検索 = 1000 リクエスト、平均3.5秒間隔で約58分。
MAX_ACTIVE_ROUTES=500
MAX_WATCHES_PER_IP_PER_DAY=10
MAX_ACTIVE_WATCHES_PER_IP=20

# --- ライフサイクル（匿名ゆえに必須。放置モニターを無期限に収集しない）---
WATCH_IDLE_EXPIRY_DAYS=60
WATCH_POST_DEPARTURE_GRACE_DAYS=7

# 出発日まで必ず収集しきるか。
# false（仕様 2.4 当初の規則）だと、放置期限のほうが先に来たときに系列が
# 出発日に届かず途中で切れる。途中で切れた系列は「残り期間の最小値が
# いくらだったか」が確定しないので、価格曲線の推定にも学習にも使えない。
# 日次コストの天井は変わらない（MAX_ACTIVE_ROUTES で決まる）。変わるのは
# ルート枠の回転速度。
COLLECT_UNTIL_DEPARTURE=true

# --- Web ---
# 登録できる出発日の上限（今日から何日先まで）。
# 無制限にすると「10年先」の収集し続けるだけのモニターを作られる。
MAX_DEPARTURE_DAYS_AHEAD=400

# IP ハッシュのソルト。**生の IP は保存しない。**
# 空なら data/.ip_salt に自動生成される（設定し忘れて「ソルト無し」で
# 動くのが一番ありそうな失敗なので、既定を安全側にしてある）。
# 本番は AWS Secrets Manager から与える。
IP_HASH_SALT=

# X-Forwarded-For を信用するか。
# **true にしてよいのは、リバースプロキシがこのヘッダを必ず上書きする構成のときだけ。**
# （Caddy なら header_up X-Forwarded-For {remote_host}）
# 直接公開したまま true にすると、クライアントが偽の IP を名乗って
# レート制限を素通りできる。
TRUST_PROXY_HEADERS=false

# 自動生成 API ドキュメント（/api/docs）。本番は false。
DOCS_ENABLED=true

# --- 予測 ---
# 較正に使う直近の観測点数。この窓の「実測 / 曲線」比の中央値を取る。
# 1点だと最終観測日の外れ値ひとつで予測全体が歪む（移植元の欠陥）。
CALIBRATION_WINDOW=7

# 信頼帯の広さ。観測が少ないほど、また予測が先に伸びるほど広くなる。
# 実測3日分と40日分が同じ確信度に見えてはいけない。
BAND_BASE_UNCERTAINTY=0.05
BAND_SMALL_SAMPLE_K=1.0
BAND_HORIZON_K=0.5
BAND_MAX_RATIO=0.60

# 価格曲線パラメータの JSON。未設定なら app/predict/curve.py の既定値。
# Phase 3.5 で実測から推定した値を書き出す先。
# CURVE_PARAMS_PATH=./data/curve-params.json

# --- 原油価格（初期は無効）---
# 寄与係数。Phase 0 Q5 の決定により初期は 0（無効）。
# モニター期間が最大60日程度では原油変動の寄与がほぼ定数になり、
# 較正のスケール項に吸収されてしまうため。実測が貯まってから有効化する。
# 0 のときは EIA へのアクセスを一切行わない（キー不要）。
OIL_COEFFICIENT=0.0
OIL_LAG_MONTHS=3
OIL_BASELINE_USD=80.0
# EIA の API キー。**コードに直書きしない。**
# 本番は AWS Secrets Manager 経由にする。
EIA_API_KEY=
